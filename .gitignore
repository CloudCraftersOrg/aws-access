# This repo is public. Do not add negation patterns (!) for anything below.

# Backend wiring names the state bucket. CI passes it from a repo variable.
backend.conf

# Real values for state buckets and prefixes come from repo variables.
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json

# State lives in S3 and contains every account ID and ARN.
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Binary, but contains every value the plan resolved.
*.tfplan
tfplan
plan.out
plan.json

.terraform/

# Can contain registry credentials
.terraformrc
terraform.rc
.terraform.d/

# Can include variable values
crash.log
crash.*.log

override.tf
override.tf.json
*_override.tf
*_override.tf.json

.DS_Store
.idea/
.vscode/
*.swp
